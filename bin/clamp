#!/usr/bin/env bash
# clamp — claude + amp-style thread command palette
#
# Wraps `claude` in an isolated tmux server and adds a hotkey-driven command
# palette for switching threads, referencing threads (@@<uuid>), and starting
# new threads.
#
# Usage:
#   clamp start [dir]       Start (or attach to) a clamp session for [dir]
#   clamp picker            (internal) top-level command palette
#   clamp switch            (internal) thread switcher
#   clamp reference         (internal) thread reference picker
#   clamp new               (internal) start a fresh thread
#   clamp kill              Kill the clamp tmux server entirely
#   clamp list-threads      Print TSV of threads for $PWD
#   clamp render <sid>      Print formatted thread transcript

set -euo pipefail

# Resolve our own location, following any symlinks (e.g. ~/.local/bin/clamp
# -> ~/dev/clamp/bin/clamp). Portable across macOS (BSD readlink, no -f).
_clamp_resolve_root() {
    local src="${BASH_SOURCE[0]}"
    while [[ -L "$src" ]]; do
        local dir
        dir="$(cd -P "$(dirname "$src")" && pwd)"
        src="$(readlink "$src")"
        [[ $src != /* ]] && src="$dir/$src"
    done
    cd -P "$(dirname "$src")/.." && pwd
}
readonly CLAMP_ROOT="$(_clamp_resolve_root)"
readonly CLAMP_LIB="$CLAMP_ROOT/lib"
readonly CLAMP_SOCKET="${CLAMP_SOCKET:-clamp}"
readonly CLAMP_HOTKEY="${CLAMP_HOTKEY:-C-g}"
readonly CLAMP_CONF="$CLAMP_ROOT/tmux.conf"
# Flags passed to every `claude` invocation. Defaults to bypassing permission
# prompts so the wrapper stays out of your way; override with an env var to
# tighten back up.
readonly CLAMP_CLAUDE_FLAGS="${CLAMP_CLAUDE_FLAGS:---dangerously-skip-permissions}"
# Model used for the one-shot summary in `clamp handoff`. Override via env.
readonly CLAMP_HANDOFF_MODEL="${CLAMP_HANDOFF_MODEL:-haiku}"

readonly TMUX_CMD=(tmux -L "$CLAMP_SOCKET")

die() { echo "clamp: $*" >&2; exit 1; }

# Sanitize a path into a usable tmux session name.
session_name_for_dir() {
    local dir="$1" base
    base="$(basename "$dir")"
    # tmux disallows '.' and ':' in session names
    base="${base//./_}"
    base="${base//:/_}"
    [[ -z "$base" ]] && base="clamp"
    echo "$base"
}

# Install the hotkey binding on the running server. Idempotent.
install_bindings() {
    # Important: `#{pane_id}` is NOT expanded inside the shell-command arg of
    # display-popup on every tmux build. Use `-e VAR=#{...}` instead, which
    # is reliably format-expanded at fire time.
    "${TMUX_CMD[@]}" bind-key -T root "$CLAMP_HOTKEY" \
        display-popup -E -w 80% -h 80% \
        -d "#{pane_current_path}" \
        -e "CLAMP_TARGET_PANE=#{pane_id}" \
        -e "CLAMP_PROJECT_DIR=#{pane_current_path}" \
        "'$CLAMP_ROOT/bin/clamp' picker"
}

cmd_start() {
    local dir="${1:-$PWD}"
    dir="$(cd "$dir" && pwd)"
    local sess
    sess="$(session_name_for_dir "$dir")"

    # Create the session if missing. -f only takes effect when the server is
    # being started for the first time; otherwise it is silently ignored.
    # Each thread lives in its own window inside this session, so attaching
    # later reattaches to whatever windows are still running.
    if ! "${TMUX_CMD[@]}" has-session -t "=$sess" 2>/dev/null; then
        "${TMUX_CMD[@]}" -f "$CLAMP_CONF" new-session -d -s "$sess" -c "$dir" \
            -e "CLAMP_PROJECT_DIR=$dir" \
            -n "new" \
            "claude $CLAMP_CLAUDE_FLAGS"
    fi

    # Expose CLAMP_LIB to the tmux server's global env so shell commands
    # spawned by status-bar #(...) substitutions can find lib/status-line.sh.
    # Idempotent — safe to re-set on every start.
    "${TMUX_CMD[@]}" set-environment -g CLAMP_LIB "$CLAMP_LIB"

    # Re-source the conf so an already-running server picks up changes
    # (status-right format, colors, etc.) without requiring `clamp kill`.
    # tmux only loads -f at first server boot, so we have to source again
    # here for upgrades to take effect on existing sessions.
    "${TMUX_CMD[@]}" source-file "$CLAMP_CONF" 2>/dev/null || true
    "${TMUX_CMD[@]}" refresh-client -S 2>/dev/null || true

    install_bindings

    if [[ -n "${TMUX:-}" ]]; then
        # Already inside another tmux: can't nest attach.
        echo "You're already inside tmux. Detach first, then run: clamp $dir" >&2
        return 1
    fi

    # Attach. When this returns, the user has either detached or claude
    # exited (taking the pane and session with it).
    "${TMUX_CMD[@]}" attach-session -t "$sess" || true

    # If no sessions remain on the clamp server, tear the whole server down.
    # That way `clamp` behaves like a foreground app — no daemon left over.
    if ! "${TMUX_CMD[@]}" list-sessions >/dev/null 2>&1 \
       || [[ -z "$("${TMUX_CMD[@]}" list-sessions 2>/dev/null)" ]]; then
        "${TMUX_CMD[@]}" kill-server >/dev/null 2>&1 || true
    fi
}

cmd_kill() {
    "${TMUX_CMD[@]}" kill-server 2>/dev/null || true
    echo "clamp tmux server stopped."
}

# Re-source tmux.conf and refresh status, without disturbing running panes.
# Useful after editing tmux.conf or upgrading clamp while a session is alive.
cmd_reload() {
    if ! "${TMUX_CMD[@]}" list-sessions >/dev/null 2>&1; then
        echo "no clamp tmux server running."
        return 0
    fi
    "${TMUX_CMD[@]}" set-environment -g CLAMP_LIB "$CLAMP_LIB"
    "${TMUX_CMD[@]}" source-file "$CLAMP_CONF"
    "${TMUX_CMD[@]}" refresh-client -S
    install_bindings
    echo "clamp tmux conf reloaded."
}

cmd_install_skill() {
    local src="$CLAMP_ROOT/claude/skills/read-thread"
    local dst="$HOME/.claude/skills/read-thread"

    [[ -d "$src" ]] || die "skill source missing: $src"
    mkdir -p "$HOME/.claude/skills"

    if [[ -L "$dst" ]]; then
        # Existing symlink: just repoint it (idempotent reinstall).
        rm -f "$dst"
    elif [[ -e "$dst" ]]; then
        # Real file/dir there — refuse to clobber user content.
        echo "Refusing to overwrite non-symlink $dst (rm it manually first)" >&2
        return 1
    fi

    ln -s "$src" "$dst"
    echo "Installed: $dst -> $src"
    echo
    echo "Claude Code will load this skill when it sees '@@<uuid>' in a prompt."
    echo "Make sure 'clamp' is on PATH so the skill can call 'clamp render <uuid>':"
    echo "    ln -s '$CLAMP_ROOT/bin/clamp' ~/.local/bin/clamp"
}

cmd_list_threads() {
    local dir="${1:-$PWD}"
    python3 "$CLAMP_LIB/list-threads.py" "$dir"
}

cmd_render() {
    local sid="${1:-}"
    local dir="${2:-$PWD}"
    [[ -z "$sid" ]] && die "render: missing session-id"
    python3 "$CLAMP_LIB/render-thread.py" "$sid" "$dir"
}

# Pause for a keypress before exit so errors are readable in a popup.
fatal() {
    echo >&2
    echo "clamp: $*" >&2
    echo >&2
    echo "(press any key to close)" >&2
    read -rsn1 || true
    exit 1
}

# Resolve the originating pane id and project dir, populating
# CLAMP_TARGET_PANE / CLAMP_PROJECT_DIR. Robust against the case where the
# -e env-var format-expansion didn't fire (still has literal "#{...}").
resolve_target() {
    local target="${CLAMP_TARGET_PANE:-}"
    if [[ -z "$target" || "$target" == *'#{'* ]]; then
        # Strategy 1: ask the active client what session it's on, then take
        # its first pane (clamp sessions only ever have one).
        local sess
        sess="$("${TMUX_CMD[@]}" list-clients -F '#{client_session}' 2>/dev/null | head -1 || true)"
        if [[ -n "$sess" ]]; then
            target="$("${TMUX_CMD[@]}" list-panes -t "$sess" -F '#{pane_id}' 2>/dev/null | head -1 || true)"
        fi
    fi
    if [[ -z "$target" || "$target" == *'#{'* ]]; then
        # Strategy 2: just take the first pane across all sessions on this
        # clamp server. Works even if list-clients returns nothing.
        target="$("${TMUX_CMD[@]}" list-panes -a -F '#{pane_id}' 2>/dev/null | head -1 || true)"
    fi
    if [[ -z "$target" ]]; then
        {
            echo "couldn't determine target pane."
            echo "  CLAMP_TARGET_PANE=${CLAMP_TARGET_PANE:-<unset>}"
            echo "  list-clients:"
            "${TMUX_CMD[@]}" list-clients 2>&1 | sed 's/^/    /' || true
            echo "  list-panes -a:"
            "${TMUX_CMD[@]}" list-panes -a 2>&1 | sed 's/^/    /' || true
        } >>/tmp/clamp.log
        fatal "couldn't determine target pane (see /tmp/clamp.log)"
    fi

    local proj="${CLAMP_PROJECT_DIR:-}"
    if [[ -z "$proj" || "$proj" == *'#{'* ]]; then
        proj="$("${TMUX_CMD[@]}" display-message -p -t "$target" -F '#{pane_current_path}' 2>/dev/null || true)"
    fi
    [[ -z "$proj" ]] && proj="$PWD"

    export CLAMP_TARGET_PANE="$target"
    export CLAMP_PROJECT_DIR="$proj"

    # Audit trail
    {
        echo "[$(date '+%H:%M:%S')] resolve_target → pane=$target proj=$proj"
    } >>/tmp/clamp.log 2>&1 || true
}

# -------- Picker (top-level command palette) --------
cmd_picker() {
    resolve_target

    local choice
    choice="$(printf '%s\n' \
        "switch     Switch to an existing thread" \
        "reference  Insert @@<thread-id> reference into prompt" \
        "handoff    Hand off context to a fresh thread (auto-summarized)" \
        "new        Start a new thread" \
        | fzf --ansi --no-multi \
              --prompt="clamp ❯ " \
              --header="$CLAMP_PROJECT_DIR" \
              --with-nth=1.. \
              --reverse \
              --height=100%)" || return 0

    case "${choice%% *}" in
        switch)    cmd_switch ;;
        reference) cmd_reference ;;
        handoff)   cmd_handoff ;;
        new)       cmd_new ;;
        *)         return 0 ;;
    esac
}

# -------- Thread picker shared by switch/reference --------
# $1 = mode label ("switch"/"reference"), $2 = action callback name
_thread_picker() {
    local mode="$1"
    local proj="${CLAMP_PROJECT_DIR:-$PWD}"

    local lines
    lines="$(python3 "$CLAMP_LIB/list-threads.py" "$proj")"
    if [[ -z "$lines" ]]; then
        echo "No prior threads found for $proj"
        echo "(Press any key to close)"
        read -rsn1
        return 1
    fi

    # fzf consumes TSV: <id>\t<mtime>\t<rel>\t<title>
    # Display: <rel>  <title>  (id hidden but kept in line for selection)
    local sel
    sel="$(printf '%s\n' "$lines" | fzf \
        --ansi --no-multi --reverse --height=100% \
        --delimiter=$'\t' \
        --with-nth=3,4 \
        --prompt="$mode ❯ " \
        --header="$proj  —  ↑/↓ navigate, shift+↑/↓ scroll preview, enter selects, esc cancels" \
        --preview="python3 $CLAMP_LIB/render-thread.py {1} $proj" \
        --preview-window="right,65%,wrap")" || return 0

    # Parse the selected session id (column 1).
    local sid
    sid="$(awk -F'\t' '{print $1}' <<<"$sel")"
    [[ -z "$sid" ]] && return 0
    echo "$sid"
}

# Print the tmux session name that owns the resolved target pane.
_target_session() {
    "${TMUX_CMD[@]}" display-message -p -t "$CLAMP_TARGET_PANE" \
        -F '#{session_name}'
}

# Echo the window id of an existing window in $sess that is tagged with the
# given sid, or empty if none. Tags are set by cmd_switch when it spawns
# a `claude --resume <sid>` window.
_window_for_sid() {
    local sess="$1" sid="$2"
    "${TMUX_CMD[@]}" list-windows -t "$sess" \
        -F '#{window_id} #{@clamp_sid}' 2>/dev/null \
        | awk -v s="$sid" '$2==s {print $1; exit}'
}

cmd_switch() {
    resolve_target
    local sid
    sid="$(_thread_picker switch)" || return 0
    [[ -z "${sid:-}" ]] && return 0

    local sess
    sess="$(_target_session)"
    [[ -z "$sess" ]] && fatal "couldn't determine target session"

    # Already running in some window? Just jump to it — leave its claude
    # process untouched.
    local existing
    existing="$(_window_for_sid "$sess" "$sid")"
    if [[ -n "$existing" ]]; then
        "${TMUX_CMD[@]}" select-window -t "$existing"
        return 0
    fi

    # Otherwise spawn a fresh window with `claude --resume <sid>` and tag
    # it so subsequent switches dedupe to the same window.
    local new_wid
    new_wid="$("${TMUX_CMD[@]}" new-window -t "$sess:" \
        -c "$CLAMP_PROJECT_DIR" \
        -n "${sid:0:8}" \
        -P -F '#{window_id}' \
        "claude $CLAMP_CLAUDE_FLAGS --resume $sid")"
    if [[ -n "$new_wid" ]]; then
        "${TMUX_CMD[@]}" set-option -w -t "$new_wid" @clamp_sid "$sid"
    fi
}

cmd_reference() {
    resolve_target
    local sid
    sid="$(_thread_picker reference)" || return 0
    [[ -z "${sid:-}" ]] && return 0

    local target="$CLAMP_TARGET_PANE"
    local log=/tmp/clamp.log
    local payload="@@$sid "

    # Stage the text in a named tmux paste buffer (synchronous; survives
    # popup teardown).
    "${TMUX_CMD[@]}" set-buffer -b clamp-ref -- "$payload"

    {
        echo "--- $(date '+%H:%M:%S') reference dispatch"
        echo "target=$target sid=$sid payload=[$payload]"
    } >>"$log" 2>&1

    # Defer the paste/send to AFTER the popup closes. We use a tmux-native
    # `run-shell -b` (background) which runs from the tmux server itself,
    # not as a child of the popup's shell — so it isn't killed when the
    # popup tears down.
    "${TMUX_CMD[@]}" run-shell -b "
        echo '[bg $(date +%H:%M:%S)] firing paste/send' >> $log 2>&1
        tmux -L $CLAMP_SOCKET paste-buffer -t $target -d -p -b clamp-ref >> $log 2>&1 || \
            tmux -L $CLAMP_SOCKET send-keys -t $target -l '$payload' >> $log 2>&1
        echo '[bg $(date +%H:%M:%S)] paste/send done' >> $log 2>&1
    "
}

cmd_new() {
    resolve_target
    local sess
    sess="$(_target_session)"
    [[ -z "$sess" ]] && fatal "couldn't determine target session"

    # Fresh thread → new window. The original pane keeps running its claude
    # untouched. We don't know the sid yet (claude assigns one after the
    # first message), so the window stays untagged; switching to it later
    # via the picker will spawn a duplicate window — accept that for now.
    "${TMUX_CMD[@]}" new-window -t "$sess:" \
        -c "$CLAMP_PROJECT_DIR" \
        -n "new" \
        "claude $CLAMP_CLAUDE_FLAGS"
}

# -------- Handoff: summarize current thread, prefill new one --------
#
# UX:
#   1. Find the active thread for this project (= newest .jsonl).
#   2. Prompt the user (in the popup) for what they want to do next.
#   3. Run a one-shot `claude -p` call — model overridable via
#      $CLAMP_HANDOFF_MODEL — to compress the transcript into a handoff
#      summary aimed at the user's next intent.
#   4. Build the new prompt:
#        Continuing work from thread @@<sid>. When you lack specific
#        information, use the read-thread skill (@@<sid>) to retrieve it.
#        Next task: <intent>
#        Handoff summary: <summary>
#   5. Stage the prompt in a tmux paste buffer, respawn the pane with a
#      fresh `claude`, and defer the paste-buffer until claude is up.
cmd_handoff() {
    resolve_target
    local proj="$CLAMP_PROJECT_DIR"

    # Resolve the active thread: newest .jsonl in the project's encoded dir.
    local encoded="${proj//\//-}"
    local pdir="$HOME/.claude/projects/$encoded"
    local current_sid=""
    if [[ -d "$pdir" ]]; then
        local newest
        newest="$(ls -t "$pdir"/*.jsonl 2>/dev/null | head -1 || true)"
        [[ -n "$newest" ]] && current_sid="$(basename "$newest" .jsonl)"
    fi
    if [[ -z "$current_sid" ]]; then
        echo "No active thread found in $pdir"
        echo "(Press any key to close)"
        read -rsn1
        return 1
    fi

    # Show the title (first user message) for context.
    local title=""
    if command -v python3 >/dev/null 2>&1; then
        title="$(python3 "$CLAMP_LIB/list-threads.py" "$proj" 2>/dev/null \
                 | awk -F'\t' -v sid="$current_sid" '$1==sid {print $4; exit}')"
    fi

    clear || true
    echo "Handoff from thread:"
    echo "  $current_sid"
    [[ -n "$title" ]] && echo "  ($title)"
    echo
    echo "Type the prompt for the new thread (what you want to do next),"
    echo "then press Enter. Esc/empty cancels."
    echo

    local user_intent=""
    # -e enables readline editing; -r keeps backslashes literal.
    if ! read -r -e -p "next task ❯ " user_intent; then
        return 0
    fi
    [[ -z "${user_intent// /}" ]] && return 0

    echo
    echo "Generating handoff summary via 'claude -p --model $CLAMP_HANDOFF_MODEL'…"

    # Don't pipe the transcript — for long threads it blows the context
    # window. Instead, send the @@<uuid> reference and rely on the
    # read-thread skill to spawn a Task subagent that reads the JSONL and
    # returns only the parts relevant to the user's next task. Haiku then
    # synthesizes the final handoff summary from what the subagent returns.
    local summary_input handoff_summary
    summary_input=$'You are producing a handoff summary for a fresh Claude Code thread.\n\n'
    summary_input+="@@$current_sid"
    summary_input+=$'\n\nThe ↑ reference is the prior thread. Use the read-thread skill to read\n'
    summary_input+=$'it (it spawns a Task subagent that walks the JSONL transcript) — DO NOT\n'
    summary_input+=$'try to read the JSONL inline yourself. The next task the user wants to\n'
    summary_input+=$'work on in the new thread is:\n\n'
    summary_input+="    $user_intent"
    summary_input+=$'\n\nWhen the read-thread subagent returns, synthesize a concise handoff\n'
    summary_input+=$'(≤300 words, plain prose + short bullet lists) covering ONLY what is\n'
    summary_input+=$'relevant to that next task:\n'
    summary_input+=$'  • files/paths that were touched or are relevant\n'
    summary_input+=$'  • decisions made and approaches that worked\n'
    summary_input+=$'  • approaches that were tried and abandoned (and why)\n'
    summary_input+=$'  • open questions or in-flight work\n'
    summary_input+=$'  • a short suggested first step for the next thread\n\n'
    summary_input+=$'Output ONLY the handoff summary as plain text — no preamble, no\n'
    summary_input+=$'trailing commentary, no markdown headings about "Summary:".\n'

    # Pass --dangerously-skip-permissions so the haiku agent can spawn the
    # read-thread Task subagent without hitting permission prompts (we are
    # strictly non-interactive here).
    handoff_summary="$(printf '%s' "$summary_input" \
        | claude -p --dangerously-skip-permissions \
                 --model "$CLAMP_HANDOFF_MODEL" 2>/dev/null || true)"

    if [[ -z "${handoff_summary// /}" ]]; then
        handoff_summary="(automatic summary failed — read the source thread @@$current_sid for full context)"
    fi

    local new_prompt
    new_prompt="Continuing work from thread @@$current_sid. When you lack specific information you can use the read-thread skill to retrieve it.

Next task (from the user):
$user_intent

Handoff summary:
$handoff_summary
"

    # Stage and dispatch. Open a NEW window (so the source thread keeps
    # running in its own window untouched), then deferred-paste the
    # prompt into the new window's pane after claude has booted.
    local sess new_wid new_pane
    sess="$(_target_session)"
    [[ -z "$sess" ]] && fatal "couldn't determine target session"

    local log=/tmp/clamp.log

    "${TMUX_CMD[@]}" set-buffer -b clamp-handoff -- "$new_prompt"

    new_wid="$("${TMUX_CMD[@]}" new-window -t "$sess:" \
        -c "$CLAMP_PROJECT_DIR" \
        -n "handoff" \
        -P -F '#{window_id}' \
        "claude $CLAMP_CLAUDE_FLAGS")"
    new_pane="$("${TMUX_CMD[@]}" list-panes -t "$new_wid" \
        -F '#{pane_id}' 2>/dev/null | head -1)"

    {
        echo "--- $(date '+%H:%M:%S') handoff dispatch"
        echo "src_pane=$CLAMP_TARGET_PANE src_sid=$current_sid"
        echo "new_window=$new_wid new_pane=$new_pane"
        echo "intent=[$user_intent] summary_len=${#handoff_summary}"
    } >>"$log" 2>&1

    # Defer paste so it runs after this popup closes AND claude has booted.
    "${TMUX_CMD[@]}" run-shell -b "
        echo '[bg $(date +%H:%M:%S)] handoff: waiting for claude to boot' >> $log 2>&1
        sleep 1.5
        tmux -L $CLAMP_SOCKET paste-buffer -t $new_pane -d -p -b clamp-handoff >> $log 2>&1 || true
        echo '[bg $(date +%H:%M:%S)] handoff: paste done' >> $log 2>&1
    "
}

usage() {
    cat <<EOF
clamp — claude + amp-style thread command palette

Usage:
  clamp [dir]    Run claude in [dir] (default: \$PWD) wrapped in clamp's
                 tmux. Press $CLAMP_HOTKEY to open the command palette
                 (switch / reference / handoff / new thread). Quit claude
                 (Ctrl-D or /exit) to tear everything down.

Setup:
  ./install.sh   Install or upgrade. Re-run anytime.

Env:
  CLAMP_HOTKEY         tmux key for the palette   (default: C-g)
  CLAMP_CLAUDE_FLAGS   flags passed to claude     (default: --dangerously-skip-permissions)
  CLAMP_SOCKET         tmux -L socket name        (default: clamp)
  CLAMP_HANDOFF_MODEL  model for handoff summary  (default: haiku)
EOF
}

main() {
    # No args → start in $PWD.
    if [[ $# -eq 0 ]]; then
        cmd_start
        return
    fi

    case "$1" in
        start)         shift; cmd_start "$@" ;;
        kill)          cmd_kill ;;
        reload)        cmd_reload ;;
        install-skill) cmd_install_skill ;;
        list-threads)  shift; cmd_list_threads "$@" ;;
        render)        shift; cmd_render "$@" ;;
        picker)        cmd_picker ;;
        switch)        cmd_switch ;;
        reference)     cmd_reference ;;
        handoff)       cmd_handoff ;;
        new)           cmd_new ;;
        help|-h|--help) usage ;;
        # Anything else (a path, etc.) is treated as a `start` argument.
        *) cmd_start "$@" ;;
    esac
}

main "$@"
